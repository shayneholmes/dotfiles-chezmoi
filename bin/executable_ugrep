#!/usr/bin/env bash

#
# ugrep: Look for Unicode characters.
#

set -e -o pipefail

UNICODE_NAME_FILE=$HOME/.cache/unicode-names.txt

if ! [[ -f "$UNICODE_NAME_FILE" ]]; then
	echo "Caching Unicode file..." >&2
	curl "http://www.unicode.org/Public/UNIDATA/extracted/DerivedName.txt" -o "$UNICODE_NAME_FILE"
fi

[[ -n "$*" ]] || (echo "No pattern provided!"; exit 1)

PATTERN="^[0-9a-f]+.*$*"

grep -E -i -e "$PATTERN" "${UNICODE_NAME_FILE[0]}" | \
	while read -r a b; do \
		if [[ "0x$a" -gt 0 ]]; then
			printf "\U$(printf "%08x" "0x$a")\tU+%s\t&#%06d;\t%s\n" "$a" "0x$a" "$b"; \
		fi
	done | \
	less --quit-if-one-screen --chop-long-lines
