alias rc='vim ${ZDOTDIR}/.zshrc && source ${ZDOTDIR}/.zshrc'

if command -v trash >/dev/null 2>&1; then
  alias rm='trash'
fi

function vim() {
  if [ -n "$VIM_TERMINAL" ]; then
    echo "Already in a vim terminal!"
    return 1
  fi
  command vim $*
}

# TODO: Pull out this completion thing into its own file
zle -C all-matches complete-word _generic
bindkey '^Xa' all-matches
zstyle ':completion:all-matches:*' insert yes
zstyle ':completion:all-matches::::' completer \
  _all_matches _complete

autoload -U +X bashcompinit && bashcompinit
alias t='todo.sh'
alias tl='t list'
alias tlp='t listpri'
[[ -z /usr/local/Cellar/todo-txt/2.11.0/etc/bash_completion.d/todo_completion ]] && source /usr/local/Cellar/todo-txt/2.11.0/etc/bash_completion.d/todo_completion
complete -F _todo t

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
command -v fzf >/dev/null 2>&1 && command -v fd >/dev/null 2>&1 && \
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --ignore-file ~/.config/fd/ignore .'

export FZF_DEFAULT_OPTS='--bind change:top'

export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME}/ripgrep/config"

__pretty_rg() {
  rg --pretty --no-line-number --no-filename "$*" | less -RFX
}
alias prg=__pretty_rg

rg() {
    if [ -t 1 ]; then
        command rg -p "$@" | less -RFX
    else
        command rg "$@"
    fi
}

# -x3 = Set tab stops to 3 spaces (intentionally different from any space counts I would ever use)
# -R = Output "raw" control characters. (colors)
# -F = Don't open with less if entire file fits on screen.
# -s = Squeeze multiple blank lines.
# -X = Ignore ignore termcap initialization. With xterms it keeps
#        the last page of the document on the screen. (see
#        http://www.shallowsky.com/linux/noaltscreen.html)
export LESS="-x3RFsX"
export LESSOPEN="| src-hilite-lesspipe.sh %s"

GPG_TTY=$(tty)
export GPG_TTY

export GOPATH=$HOME/go:/Volumes/code/go

# Increase number of files available. (Used by duplicacy-fuse.)
ulimit -n 10240

# Report timing statistics for commands that take a while
export REPORTTIME=10

# Disable snyk messages
export DOCKER_SCAN_SUGGEST=false

jwtd() {
    if [[ -x $(command -v jq) ]]; then
         jq -R 'split(".") | .[0],.[1] | @base64d | fromjson' <<< "${1}"
         echo "Signature: $(echo "${1}" | awk -F'.' '{print $3}')"
    fi
}

export TERM=xterm-256color

