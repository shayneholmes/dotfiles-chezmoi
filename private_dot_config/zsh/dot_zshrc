zinit light shayneholmes/zsh-ssh-host-color

command -v fasd >/dev/null 2>&1 && eval "$(fasd --init auto)"

zinit light wookayin/fzf-fasd
zinit light okapia/zsh-viexchange
zinit light zsh-users/zsh-autosuggestions
ZSH_AUTOSUGGEST_USE_ASYNC=true

export ASDF_CONFIG_FILE="${XDG_CONFIG_HOME}/asdf/asdfrc"
export ASDF_DATA_DIR="${XDG_CACHE_HOME}/asdf"
zinit light asdf-vm/asdf
alias aoeu=asdf

zinit ice pick'lowkey.zsh-theme'
zinit ice atinit'zpcompinit; zpcdreplay'
zinit light shayneholmes/zsh-themes

