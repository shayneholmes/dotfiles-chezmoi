function config {
  git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME $@
}
compdef config=git

function gclocd {
  # git clone and enter the cloned file
  if [[ -z "$2" ]]; then
    reponame=$(basename "$1" ".git");
  else
    reponame=$2;
  fi
  git clone "$1" "$reponame" && \
  cd "$reponame";
}

alias cm='chezmoi'
alias dp='duplicacy'
alias gap='git add -p'
alias gcf='git commit --fixup'
alias gcl='gclocd'
alias gcob='git checkout -b'
alias gcop='git cop'
alias gdc='git diff --cached'
alias gg='git gg'
alias glp="git log -p"
alias gp="git push"
alias gs='git status'
alias gsh='git show'
alias l=ls
alias la='ls -a'
alias ll='ls -lh'
alias lla='ls -lah'
alias lsc='ls -G'
alias ra='ranger'
alias td='date +%F'
alias v='vim'
alias y='config'
alias yap='config add -p'
alias yc!='config commit --amend'
alias yc='config commit'
alias yf='config fetch'
alias ylp='config log -p'
